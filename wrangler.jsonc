{
  // Worker + static assets deployment (Workers Builds: build "npm run build", deploy "npx wrangler deploy")
  "name": "dynabyt-static",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Keep variables and secrets added in the Cloudflare dashboard when this config is deployed.
  "keep_vars": true,
  // Public values only. Keys and passwords (RESEND_API_KEY, SUPABASE_SERVICE_KEY) stay as dashboard Secrets.
  "vars": { "SUPABASE_URL": "https://ocwykdiqtbewogfsiojw.supabase.co" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Keep Workers Logs on so delivery problems from the contact form are visible (Observability > Logs).
  "observability": { "enabled": true, "head_sampling_rate": 1 }
  // To also save every enquiry (recommended), create a KV namespace named SUBMISSIONS in the dashboard,
  // then uncomment this and paste its id:
  // , "kv_namespaces": [{ "binding": "SUBMISSIONS", "id": "PASTE_NAMESPACE_ID" }]
}
